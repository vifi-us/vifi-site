---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import HeroHome from "../components/blocks/HeroHome.astro";
import ProblemStatement from "../components/blocks/ProblemStatement.astro";
import ThreePillars from "../components/blocks/ThreePillars.astro";
import HowItWorksPreview from "../components/blocks/HowItWorksPreview.astro";
import FeatureHighlights from "../components/blocks/FeatureHighlights.astro";
import ComparisonTeaser from "../components/blocks/ComparisonTeaser.astro";
import TrustStrip from "../components/blocks/TrustStrip.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
---

<BaseLayout
  title="ViFi AI Phone Assistant | Answer Every Business Call"
  description="ViFi answers business calls, captures what each caller needs, and sends you a clear recap so you can follow up with context."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main>
      <HeroHome />
      <ProblemStatement />
      <ThreePillars />
      <HowItWorksPreview />
      <FeatureHighlights />
      <ComparisonTeaser />
      <TrustStrip />
      <CTABanner
        heading="Ready to answer every call?"
        description="Set up your agent and hear it take a real call in minutes. Free for 7 days, no credit card required."
        ctaId="home-banner"
      />
    </main>
    <Footer />
  </div>

  <!-- Background ambient gradient -->
  <div
    class="pointer-events-none fixed inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="absolute inset-0 ambient-gradient"></div>
  </div>
</BaseLayout>
