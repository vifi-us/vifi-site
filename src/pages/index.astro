---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import HomeStory from "../components/home/HomeStory.astro";
---

<BaseLayout
  title="ViFi AI Receptionist for Small Business"
  description="ViFi answers business calls, captures what every caller needs, and sends summaries, transcripts, and recordings. Start a free 7-day trial—no card."
  ogTitle="ViFi: Answer every call. Know what happens next."
  ogDescription="An AI receptionist for small businesses that answers calls, captures what each caller needs, and sends a clear post-call briefing."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <HomeStory />
    </main>
    <Footer />
  </div>
</BaseLayout>
