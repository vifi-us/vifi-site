---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { siteConfig } from "../../data/site";

const resource = await getEntry("resources", "ai-receptionist-test-scorecard");
if (!resource) throw new Error("Missing AI receptionist scorecard content");
const { title, description, heading, version, publishedAt, scenarios } = resource.data;
const revisionDate = publishedAt.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title={title}
  description={description}
>
  <div class="scorecard-chrome"><Header /></div>
  <main id="main" class="scorecard-shell">
    <header class="scorecard-heading">
      <p class="eyebrow"><i></i>{`Free field worksheet · ${version} / ${revisionDate}`}</p>
      <h1>{heading}</h1>
      <p class="lede">A seven-call scorecard for evaluating an AI receptionist with your own business rules.</p>
      <p>Use this with ViFi or another provider.{" "}<strong>No email or account is required.</strong>{" "}Use fictional customer details and a callback number you control. Keep your normal routing in place while testing.</p>
      <div class="scorecard-actions">
        <button class="btn" type="button" data-print-scorecard>Print / save as PDF</button>
        <a class="text-link" href="/resources/ai-receptionist-test-scorecard.csv" download>Download editable CSV</a>
        <a class="text-link" href="/blog/test-ai-receptionist-home-services/">Read the full call scripts</a>
      </div>
      <noscript><p>Use your browser's Print command to print this worksheet or save it as a PDF.</p></noscript>
      <p class="scorecard-meta">Provider / setup version: ____________________ &nbsp; Date: __________ &nbsp; Reviewer: ____________________</p>
      <p class="scorecard-instructions">For each call, mark{" "}<strong>Pass / Fix / Not supported</strong>. Record the call time, the actual result and a human owner. Retest after changing the setup.</p>
    </header>
    <ol class="scorecard-list">
      {scenarios.map(({ title, criterion }, index) => (
        <li class="scorecard-row">
          <div class="scorecard-row-title"><h2>{`${index + 1}. ${title}`}</h2><span>Pass / Fix / Not supported</span></div>
          <p><strong>Check:</strong>{" "}{criterion}</p>
          <p class="scorecard-notes">Call time: __________ &nbsp; Actual result / fix: ____________________________________________</p>
          <p class="scorecard-notes">Owner / retest date: ______________________________________________________________</p>
        </li>
      ))}
    </ol>
    <aside class="scorecard-decision" aria-labelledby="scorecard-decision-title">
      <h2 id="scorecard-decision-title">Decide from the evidence, not a total score</h2>
      <p>Wrong contact details, unsupported promises and failed handoffs are stop conditions. Fix them before live routing. “Not supported” is a buying decision: decide whether that capability is essential for your team. This is not an emergency-handling test or a product certification.</p>
      <p>Next step / owner: __________________________________________________________________</p>
    </aside>
    <section class="scorecard-next" aria-labelledby="scorecard-next-title">
      <h2 id="scorecard-next-title">Try the first call with ViFi</h2>
      <p>Configure your intake rules, make a test call, then review the briefing. Keep test calls separate from customer demand.</p>
      <a class="btn" href={siteConfig.registerUrl} data-cta="scorecard-start-trial" data-cta-version="test-scorecard-2026-09-v1" data-cta-intent="proof">Start a free trial</a>
      <a class="text-link" href="/solutions/home-services/">See the home-services workflow</a>
    </section>
    <p class="scorecard-print-source">ViFi · vifi.us/resources/ai-receptionist-test-scorecard/ · Full scripts: vifi.us/blog/test-ai-receptionist-home-services/</p>
  </main>
  <div class="scorecard-chrome"><Footer /></div>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>("[data-print-scorecard]")?.addEventListener("click", () => window.print());
</script>

<style>
  .scorecard-shell { width: min(960px, calc(100% - 40px)); margin: 0 auto; padding: 48px 0 72px; }
  .scorecard-heading { display: grid; gap: 20px; }
  .scorecard-heading h1 { font-size: clamp(36px, 6vw, 56px); }
  .scorecard-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin: 8px 0; }
  .scorecard-meta { padding: 18px 0; border-block: 1px solid var(--color-border); overflow-wrap: anywhere; }
  .scorecard-list { list-style: none; padding: 0; display: grid; gap: 18px; margin: 28px 0; }
  .scorecard-row { padding: 22px; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); break-inside: avoid; }
  .scorecard-row-title { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .scorecard-row h2 { font-size: 22px; }
  .scorecard-row-title span { font-size: 13px; font-weight: 600; }
  .scorecard-row p + p { margin-top: 14px; }
  .scorecard-notes { color: var(--color-muted); overflow-wrap: anywhere; }
  .scorecard-decision { background: var(--color-tint); padding: 24px; border-left: 3px solid var(--color-accent); }
  .scorecard-decision h2, .scorecard-next h2 { font-size: 28px; }
  .scorecard-decision p, .scorecard-next p { margin-top: 14px; overflow-wrap: anywhere; }
  .scorecard-next { padding: 40px 0; }
  .scorecard-next a { margin: 22px 22px 0 0; }
  .scorecard-print-source { font-size: 12px; color: var(--color-muted); overflow-wrap: anywhere; }
  @media print {
    @page { size: auto; margin: 12mm; }
    :global(body), :global(.site) { background: var(--color-surface) !important; color: var(--color-text) !important; }
    :global(body > :not(.site)), :global(.skip), .scorecard-chrome, .scorecard-actions, .scorecard-next, noscript { display: none !important; }
    .scorecard-shell { width: 100%; padding: 0; font-size: 9pt; line-height: 1.3; }
    .scorecard-heading { gap: 7px; }
    .scorecard-heading h1 { font-size: 23pt; }
    .scorecard-heading .lede { font-size: 11pt; line-height: 1.3; }
    .eyebrow { font-size: 8pt; }
    .scorecard-meta { padding: 7px 0; }
    .scorecard-list { gap: 4px; margin: 8px 0; }
    .scorecard-row { padding: 5px 8px; border-radius: 0; }
    .scorecard-row-title { gap: 5px; margin-bottom: 3px; }
    .scorecard-row h2 { font-size: 11pt; }
    .scorecard-row-title span { font-size: 8pt; }
    .scorecard-row p + p { margin-top: 2px; }
    .scorecard-decision { padding: 8px 10px; break-inside: avoid; }
    .scorecard-decision h2 { font-size: 11pt; }
    .scorecard-decision p { margin-top: 4px; }
    .scorecard-print-source { margin-top: 7px; font-size: 7pt; }
  }
</style>
