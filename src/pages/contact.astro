---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import PageHero from "../components/blocks/PageHero.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Contact ViFi | Get in Touch"
  description="Have questions about ViFi? Reach out to our team, or start your free trial."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <PageHero
        title="Get in touch"
        subtitle="Questions, feedback, or just want to learn more? We're here."
      />

      <section class="pb-12">
        <div class="mx-auto max-w-md px-6">
          <div class="blob-card px-6 py-9 text-center sm:px-10 sm:py-10">
            <svg
              class="blob"
              viewBox="0 0 800 400"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M26 42 Q20 12 52 14 L748 6 Q784 4 782 40 L790 358 Q792 392 756 390 L50 396 Q14 398 18 362 Z"
              ></path>
            </svg>
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.12em] text-muted-2">
              Email us directly at
            </p>
            <a
              href={`mailto:${siteConfig.email}`}
              class="text-link text-2xl sm:text-[28px] [&_svg]:h-6 [&_svg]:w-6"
            >
              {siteConfig.email}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14 M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <CTABanner
        heading="Ready to try ViFi?"
        description="Start your 7-day free trial. No credit card required."
        ctaId="contact-banner"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
