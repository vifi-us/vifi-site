---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import PageHero from "../components/blocks/PageHero.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Contact ViFi | Get in Touch"
  description="Have questions about ViFi? Reach out to our team, or start your free trial."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <PageHero
        title="Get in touch"
        subtitle="Questions, feedback, or just want to learn more? We're here."
      />

      <section class="pb-12">
        <div class="mx-auto max-w-md px-6 text-center">
          <p class="text-base text-muted mb-2">Email us directly at</p>
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-lg font-semibold text-accent hover:text-accent/80 transition-colors"
          >
            {siteConfig.email}
          </a>
        </div>
      </section>

      <CTABanner
        heading="Ready to try ViFi?"
        description="Start your 7-day free trial. No credit card required."
        ctaId="contact-banner"
      />
    </main>
    <Footer />
  </div>

  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 ambient-gradient"></div>
  </div>
</BaseLayout>
