---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";

export async function getStaticPaths() {
  const pages = await getCollection("legal");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const formattedDate = page.data.effectiveDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = page.data.effectiveDate.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${page.data.title} | ViFi`}
  description={page.data.description}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <article class="py-16 sm:py-24">
        <div class="mx-auto max-w-3xl px-6">
          <h1>{page.data.title}</h1>
          <p class="mt-4 font-mono text-[13px] tracking-[0.02em] text-muted-2">
            Effective: <time datetime={isoDate}>{formattedDate}</time>
          </p>

          <!-- Only the wrapper is styled; the markdown renders as-is, with no JavaScript needed. -->
          <div
            class="mt-10 sm:mt-12
              [&_p]:mb-6 [&_p]:text-[17px] [&_p]:leading-[28px] [&_p]:text-muted
              [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-[28px] [&_h2]:sm:text-[32px] [&_h2]:font-semibold [&_h2]:text-text
              [&_h3]:mt-9 [&_h3]:mb-3 [&_h3]:font-semibold [&_h3]:text-text
              [&_h4]:mt-8 [&_h4]:mb-2 [&_h4]:text-[18px] [&_h4]:font-semibold [&_h4]:text-text
              [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_ul]:text-[17px] [&_ul]:leading-[28px] [&_ul]:text-muted
              [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ol]:text-[17px] [&_ol]:leading-[28px] [&_ol]:text-muted
              [&_li]:pl-1 [&_li]:marker:text-accent [&_li>p]:mb-2 [&_li>blockquote]:my-3
              [&_strong]:font-semibold [&_strong]:text-text
              [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_a]:decoration-2 [&_a]:decoration-tint-3 [&_a]:underline-offset-4 [&_a]:hover:text-accent-dark [&_a]:hover:decoration-accent-dark
              [&_blockquote]:my-6 [&_blockquote]:rounded-r-[10px] [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:bg-tint [&_blockquote]:px-5 [&_blockquote]:py-4 [&_blockquote]:font-mono [&_blockquote]:text-[14px] [&_blockquote]:leading-[24px] [&_blockquote]:text-text
              [&_blockquote_p]:mb-0 [&_blockquote_p]:text-[14px] [&_blockquote_p]:leading-[24px] [&_blockquote_p]:text-text [&_blockquote_p+p]:mt-3
              [&_:not(pre)>code]:rounded-md [&_:not(pre)>code]:bg-tint [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:text-accent-dark
              [&_pre]:my-8 [&_pre]:overflow-x-auto [&_pre]:rounded-[10px] [&_pre]:border-2 [&_pre]:border-tint-2 [&_pre]:bg-tint! [&_pre]:p-5 [&_pre]:font-mono [&_pre]:text-[14px] [&_pre]:leading-[24px] [&_pre]:text-text!
              [&_pre_.line]:inline [&_pre_.line]:text-[14px] [&_pre_.line]:leading-[24px] [&_pre_.line]:font-normal [&_pre_.line]:tracking-normal [&_pre_.line]:text-text
              [&_figure]:my-10 [&_figure_a]:block [&_figure_a]:no-underline
              [&_figcaption]:mt-4 [&_figcaption]:font-mono [&_figcaption]:text-[12.5px] [&_figcaption]:leading-[20px] [&_figcaption]:text-muted
              [&_img]:h-auto [&_img]:w-full [&_img]:rounded-[12px] [&_img]:border-2 [&_img]:border-accent [&_img]:bg-surface [&_img]:shadow-[6px_6px_0_var(--color-accent)]
              [&_video]:my-10 [&_video]:block [&_video]:h-auto [&_video]:w-full [&_video]:rounded-[12px] [&_video]:border-2 [&_video]:border-accent [&_video]:bg-surface [&_video]:shadow-[6px_6px_0_var(--color-accent)]
              [&_hr]:my-10 [&_hr]:border-0 [&_hr]:border-t-2 [&_hr]:border-tint-2
              [&_table]:my-8 [&_table]:w-full [&_table]:border-collapse [&_table]:text-[15px] [&_table]:leading-relaxed
              [&_th]:border-b-2 [&_th]:border-accent [&_th]:py-2.5 [&_th]:pr-4 [&_th]:text-left [&_th]:font-semibold [&_th]:text-text
              [&_td]:border-b [&_td]:border-border [&_td]:py-2.5 [&_td]:pr-4 [&_td]:align-top [&_td]:text-muted"
          >
            <Content />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
