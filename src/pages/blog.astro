---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import PageHero from "../components/blocks/PageHero.astro";
import BlogPostCard from "../components/blocks/BlogPostCard.astro";
import CTABanner from "../components/blocks/CTABanner.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );
---

<BaseLayout
  title="Blog | ViFi"
  description="Practical advice on handling business calls, following up faster, and getting more from every conversation."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <PageHero
        title="Blog"
        subtitle="Practical advice on handling calls, following up faster, and growing your business."
      />

      <section class="pb-16 sm:pb-24">
        <div class="shell relative">
          <svg class="sprinkle left-0 -top-14" style="--dd: -1s;" viewBox="0 0 34 34" aria-hidden="true"><path d="M17 3 c2 9 5 12 14 14 c-9 2 -12 5 -14 14 c-2 -9 -5 -12 -14 -14 c9 -2 12 -5 14 -14 Z"></path></svg>
          <svg class="sprinkle right-2 -top-9" style="--dd: -2.5s;" viewBox="0 0 34 34" aria-hidden="true"><path d="M4 26 q6 -20 13 -6 q7 14 13 -6"></path></svg>
          {
            posts.length > 0 ? (
              <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9">
                {posts.map((post, index) => (
                  <BlogPostCard
                    title={post.data.title}
                    description={post.data.description}
                    publishedAt={post.data.publishedAt}
                    tags={post.data.tags}
                    slug={post.id}
                    variant={index}
                  />
                ))}
              </div>
            ) : (
              <p class="text-center text-muted">
                No posts yet. Check back soon.
              </p>
            )
          }
        </div>
      </section>

      <CTABanner
        heading="Never miss a call again"
        description="Try ViFi free for 7 days. See what it's like to call back with full context."
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
