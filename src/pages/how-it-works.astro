---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import PageHero from "../components/blocks/PageHero.astro";
import HowItWorksSteps from "../components/blocks/HowItWorksSteps.astro";
import AfterTheCall from "../components/blocks/AfterTheCall.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
import HomeServicesPath from "../components/blocks/HomeServicesPath.astro";
---

<BaseLayout
  title="How ViFi Works | AI Phone Assistant for Small Business"
  description="Forward your calls, ViFi answers professionally, and you get a full briefing after every conversation. Set up in minutes."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <PageHero
        title="How ViFi works"
        subtitle="Three steps to stop missing calls and start following up with context."
      />
      <HowItWorksSteps />
      <AfterTheCall />
      <HomeServicesPath />
      <CTABanner
        heading="Ready to stop missing calls?"
        description="Set up ViFi in minutes and start getting briefed after every conversation."
      />
    </main>
    <Footer />
  </div>

  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 ambient-gradient"></div>
  </div>
</BaseLayout>
