---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="About ViFi | AI Phone Assistant for Small Business"
  description="ViFi answers your business calls and sends you a recap of every conversation. Here's the thinking behind the product."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <section class="pt-16 pb-12 sm:pt-24 sm:pb-16">
        <div class="mx-auto max-w-3xl px-6">
          <h1 class="mb-6">About <span class="text-text">ViFi</span></h1>
          <div class="space-y-5">
            <p class="lede">
              Small business owners miss calls every day. They're with a
              customer, on a job site, or driving between appointments. The
              phone rings, nobody answers, and the caller moves on.
            </p>
            <p class="lede">
              We built ViFi because answering the call is only half the
              problem. The other half is knowing what happened on the call
              before you follow up.
            </p>
          </div>
        </div>
      </section>

      <section class="pb-16 sm:pb-24">
        <div class="mx-auto max-w-3xl space-y-12 px-6 sm:space-y-14">
          <div>
            <h2 class="mb-4 text-[28px] sm:text-[32px]">What ViFi does</h2>
            <div class="space-y-5 text-[17px] leading-7 text-muted">
              <p>
                ViFi answers your business calls with a professional voice,
                talks with the caller, and then sends you a complete recap:
                a short summary, the full transcript, and a recording. When
                you call back, you already know what was said and what needs
                to happen next.
              </p>
              <p>No guessing, no "sorry, remind me what you called about."</p>
            </div>
          </div>

          <div>
            <h2 class="mb-4 text-[28px] sm:text-[32px]">Who it's for</h2>
            <p class="text-[17px] leading-7 text-muted">
              ViFi is built for businesses where the phone drives revenue:
              contractors, medical practices, law firms, real estate agents,
              and anyone who can't afford to miss a call or return one
              unprepared.
            </p>
          </div>

          <div>
            <h2 class="mb-5 text-[28px] sm:text-[32px]">How we think about it</h2>
            <ul class="card px-6 py-3 sm:px-8 sm:py-4">
              <li class="pain">
                <i>01</i>
                <b>The callback matters most.</b>
                <p>
                  We built ViFi around what happens after the conversation,
                  not during it.
                </p>
              </li>
              <li class="pain">
                <i>02</i>
                <b>Professional voice, not a phone tree.</b>
                <p>
                  Callers talk to an AI that sounds like your front desk, not
                  a robot.
                </p>
              </li>
              <li class="pain">
                <i>03</i>
                <b>Two-minute setup.</b>
                <p>Forward your calls and you're live. No hardware, no IT.</p>
              </li>
            </ul>
          </div>

          <div>
            <h2 class="mb-4 text-[28px] sm:text-[32px]">Get in touch</h2>
            <p class="text-[17px] leading-7 text-muted">
              ViFi is live today. Every plan starts with a 7-day free trial,
              no credit card required. Questions? Reach out at
              <a href={`mailto:${siteConfig.email}`} class="font-semibold"
                >{siteConfig.email}</a
              >.
            </p>
          </div>
        </div>
      </section>

      <CTABanner
        heading="Ready to stop missing calls?"
        description="Try ViFi free for 7 days. See what a proper call recap looks like."
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
