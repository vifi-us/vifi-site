---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const postUrl = new URL(`/blog/${post.id}`, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    ...(post.data.updatedAt
      ? { dateModified: post.data.updatedAt.toISOString() }
      : {}),
    mainEntityOfPage: postUrl,
    author: { "@type": "Organization", name: "ViFi", url: new URL("/", Astro.site).href },
    publisher: { "@type": "Organization", name: "ViFi", url: new URL("/", Astro.site).href },
    image: new URL(post.data.heroImage ?? "/og-default.png", Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).href },
      { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---

<BaseLayout
  title={`${post.data.title} | ViFi Blog`}
  description={post.data.description}
  ogType="article"
  structuredData={structuredData}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <article class="py-16 sm:py-24">
        <div class="mx-auto max-w-3xl px-6">
          <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              <time class="text-sm text-muted">{formattedDate}</time>
              {
                post.data.tags.length > 0 && (
                  <div class="flex gap-2">
                    {post.data.tags.map((tag: string) => (
                      <span class="text-xs text-accent/70 bg-accent/10 rounded-full px-2 py-0.5">
                        {tag}
                      </span>
                    ))}
                  </div>
                )
              }
            </div>
            <h1
              class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight"
            >
              {post.data.title}
            </h1>
          </div>

          <div
            class="prose max-w-none
              [&_p]:text-muted [&_p]:leading-relaxed [&_p]:mb-6
              [&_h2]:text-text [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4
              [&_h3]:text-text [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3
              [&_ul]:text-muted [&_ul]:space-y-2 [&_ul]:pl-6 [&_ul]:list-disc [&_ul]:mb-6
              [&_ol]:text-muted [&_ol]:space-y-2 [&_ol]:pl-6 [&_ol]:list-decimal [&_ol]:mb-6
              [&_li]:leading-relaxed
              [&_a]:text-link [&_a]:font-medium [&_a]:underline [&_a]:decoration-link/35 [&_a]:underline-offset-4 [&_a]:hover:decoration-link [&_a]:transition-colors
              [&_strong]:text-text
              [&_blockquote]:border-l-2 [&_blockquote]:border-accent/30 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-muted"
          >
            <Content />
          </div>

          <div class="mt-12 pt-8 border-t border-border">
            <a
              href="/blog"
              class="text-sm font-semibold text-link underline decoration-link/35 underline-offset-4 transition-colors hover:decoration-link"
            >
              &larr; Back to blog
            </a>
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </div>

  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 ambient-gradient"></div>
  </div>
</BaseLayout>
