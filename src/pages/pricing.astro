---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import PageHero from "../components/blocks/PageHero.astro";
import PricingCards from "../components/blocks/PricingCards.astro";
import FAQList from "../components/blocks/FAQList.astro";
import CTABanner from "../components/blocks/CTABanner.astro";
import HomeServicesPath from "../components/blocks/HomeServicesPath.astro";
import { pricingTiers } from "../data/pricing";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ViFi",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "An AI phone assistant that answers business calls and provides post-call summaries, transcripts, and recordings.",
  url: new URL("/pricing/", Astro.site).href,
  offers: pricingTiers.map((tier) => ({
    "@type": "Offer",
    name: `${tier.name} monthly plan`,
    price: tier.price.replace("$", ""),
    priceCurrency: "USD",
    url: new URL("/pricing/", Astro.site).href,
    description: `${tier.includedMinutes.toLocaleString()} included AI minutes per month`,
  })),
};
---

<BaseLayout
  title="ViFi Pricing | Plans for Every Business Size"
  description="Simple, transparent pricing for ViFi's AI phone assistant. Every plan includes a 7-day free trial. No credit card required."
  structuredData={structuredData}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <PageHero
        title="Simple, transparent pricing"
        subtitle="Every plan includes call briefings, transcripts, and a 7-day free trial."
      />
      <PricingCards />
      <FAQList category="pricing" />
      <HomeServicesPath />
      <CTABanner
        heading="Start your free trial"
        description="Try ViFi free for 7 days. No credit card required."
        buttonText="Start free — no card"
        ctaId="pricing-banner"
        ctaVersion="pricing-2026-08-v1"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
