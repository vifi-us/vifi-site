---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import SolutionHero from "../../components/blocks/SolutionHero.astro";
import PainPoints from "../../components/blocks/PainPoints.astro";
import FeatureHighlights from "../../components/blocks/FeatureHighlights.astro";
import CallScenarioGrid from "../../components/blocks/CallScenarioGrid.astro";
import TradeSolutionLinks from "../../components/blocks/TradeSolutionLinks.astro";
import CTABanner from "../../components/blocks/CTABanner.astro";
import MissedCallOpportunity from "../../components/blocks/MissedCallOpportunity.astro";
import { solutions } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const workflowId = `${solution.slug}-workflow`;
const faqId = `${solution.slug}-faq`;
const isHomeServiceTrade = [
  "home-services",
  "hvac",
  "plumbing",
  "electricians",
].includes(solution.slug);
const stepIndex = (i: number) => String(i + 1).padStart(2, "0");

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: solution.industry,
        item: pageUrl,
      },
    ],
  },
  ...(solution.faqs
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: solution.faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: faq.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={solution.searchTitle ?? `ViFi for ${solution.industry} | AI Phone Assistant`}
  description={solution.searchDescription ?? `${solution.headline}. ViFi answers calls, handles conversations, and briefs ${solution.industry.toLowerCase()} professionals after every call.`}
  structuredData={structuredData}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <SolutionHero
        industry={solution.industry}
        headline={solution.headline}
        description={solution.description}
        slug={solution.slug}
      />
      <PainPoints painPoints={solution.painPoints} />
      {solution.slug === "home-services" && <MissedCallOpportunity />}
      {
        solution.workflow && (
          <section class="pb-16 sm:pb-24" aria-labelledby={workflowId}>
            <div class="mx-auto max-w-5xl px-6">
              <div class="grid gap-10 md:grid-cols-[0.95fr_1.05fr] md:items-center md:gap-14">
                <div class="flex flex-col gap-5">
                  <h2 id={workflowId}>How ViFi fits your call workflow</h2>
                  <p class="lede">
                    Start with one narrow use case, test realistic calls, and keep a clear path to a person for requests the assistant should not handle.
                  </p>
                </div>
                <ol class="card steps p-7 sm:p-8">
                  {solution.workflow.map((step, index) => (
                    <li class="step">
                      <i>{stepIndex(index)}</i>
                      <div>
                        <h3 class="inline text-base leading-normal font-semibold tracking-normal text-text">{step.title}</h3>{" "}
                        <span>{step.description}</span>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </section>
        )
      }
      {
        solution.callScenarios && (
          <CallScenarioGrid
            industry={solution.industry}
            scenarios={solution.callScenarios}
          />
        )
      }
      <FeatureHighlights filter={solution.relevantFeatures} />
      {
        solution.faqs && (
          <section class="py-16 sm:py-24" aria-labelledby={faqId}>
            <div class="mx-auto max-w-3xl px-6">
              <h2 id={faqId} class="mb-8">
                AI receptionist questions from {solution.industry.toLowerCase()}
              </h2>
              <div class="flex flex-col gap-4">
                {solution.faqs.map((faq) => (
                  <details class="panel group px-6 py-5">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md font-semibold text-text focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
                      {faq.question}
                      <svg
                        class="h-5 w-5 shrink-0 text-accent transition-transform group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </summary>
                    <p class="mt-4 leading-relaxed text-muted">{faq.answer}</p>
                  </details>
                ))}
              </div>
              {isHomeServiceTrade && (
                <p class="mt-8 text-muted">
                  Comparing options? Read our <a class="text-link inline" href="/blog/ai-receptionist-home-services-buyers-guide/">AI receptionist buyer's guide for home services<svg class="ml-1 inline-block align-[-3px]" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg></a>.
                </p>
              )}
            </div>
          </section>
        )
      }
      {isHomeServiceTrade && <TradeSolutionLinks currentSlug={solution.slug} />}
      <CTABanner
        heading="Test ViFi with your real call workflow"
        description="Set up ViFi, make test calls, and review the briefing before changing your normal call flow."
        ctaId={`solution-${solution.slug}-banner`}
        ctaVersion="trade-pages-2026-08-v1"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
