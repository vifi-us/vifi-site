---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import SolutionHero from "../../components/blocks/SolutionHero.astro";
import PainPoints from "../../components/blocks/PainPoints.astro";
import FeatureHighlights from "../../components/blocks/FeatureHighlights.astro";
import CallScenarioGrid from "../../components/blocks/CallScenarioGrid.astro";
import TradeSolutionLinks from "../../components/blocks/TradeSolutionLinks.astro";
import CTABanner from "../../components/blocks/CTABanner.astro";
import { solutions } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const workflowId = `${solution.slug}-workflow`;
const faqId = `${solution.slug}-faq`;
const isHomeServiceTrade = [
  "home-services",
  "hvac",
  "plumbing",
  "electricians",
].includes(solution.slug);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: solution.industry,
        item: pageUrl,
      },
    ],
  },
  ...(solution.faqs
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: solution.faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: faq.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={solution.searchTitle ?? `ViFi for ${solution.industry} | AI Phone Assistant`}
  description={solution.searchDescription ?? `${solution.headline}. ViFi answers calls, handles conversations, and briefs ${solution.industry.toLowerCase()} professionals after every call.`}
  structuredData={structuredData}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <SolutionHero
        industry={solution.industry}
        headline={solution.headline}
        description={solution.description}
      />
      <PainPoints painPoints={solution.painPoints} />
      {
        solution.workflow && (
          <section class="pb-16 sm:pb-24" aria-labelledby={workflowId}>
            <div class="mx-auto max-w-4xl px-6">
              <div class="mx-auto mb-10 max-w-2xl text-center">
                <h2 id={workflowId} class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
                  How ViFi fits your call workflow
                </h2>
                <p class="text-muted leading-relaxed">
                  Start with one narrow use case, test realistic calls, and keep a clear path to a person for requests the assistant should not handle.
                </p>
              </div>
              <ol class="grid gap-6 sm:grid-cols-3">
                {solution.workflow.map((step, index) => (
                  <li class="rounded-2xl border border-border bg-surface p-6">
                    <span class="mb-4 inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent/15 text-sm font-bold text-accent">
                      {index + 1}
                    </span>
                    <h3 class="mb-2 font-semibold text-text">{step.title}</h3>
                    <p class="text-sm leading-relaxed text-muted">{step.description}</p>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }
      {
        solution.callScenarios && (
          <CallScenarioGrid
            industry={solution.industry}
            scenarios={solution.callScenarios}
          />
        )
      }
      <FeatureHighlights filter={solution.relevantFeatures} />
      {
        solution.faqs && (
          <section class="py-16 sm:py-24" aria-labelledby={faqId}>
            <div class="mx-auto max-w-3xl px-6">
              <h2 id={faqId} class="mb-8 text-2xl sm:text-3xl font-extrabold tracking-tight">
                AI receptionist questions from {solution.industry.toLowerCase()}
              </h2>
              <div class="space-y-4">
                {solution.faqs.map((faq) => (
                  <details class="rounded-2xl border border-border bg-surface p-6">
                    <summary class="cursor-pointer font-semibold text-text">{faq.question}</summary>
                    <p class="mt-4 leading-relaxed text-muted">{faq.answer}</p>
                  </details>
                ))}
              </div>
              {isHomeServiceTrade && (
                <p class="mt-8 text-muted">
                  Comparing options? Read our <a class="font-medium text-link underline decoration-link/35 underline-offset-4" href="/blog/ai-receptionist-home-services-buyers-guide/">AI receptionist buyer's guide for home services</a>.
                </p>
              )}
            </div>
          </section>
        )
      }
      {isHomeServiceTrade && <TradeSolutionLinks currentSlug={solution.slug} />}
      <CTABanner
        heading="Test ViFi with your real call workflow"
        description="Set up ViFi, make test calls, and review the briefing before changing your normal call flow."
        ctaId={`solution-${solution.slug}-banner`}
        ctaVersion="trade-pages-2026-08-v1"
      />
    </main>
    <Footer />
  </div>

  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 ambient-gradient"></div>
  </div>
</BaseLayout>
