<script is:inline>
class HomeStory {
  componentDidMount() {
    var doc = document;
    var root = doc.querySelector('.site');
    if (root) root.classList.add('js');
    var ticking = false;

    var scroller = null;
    var scrollerChecked = false;
    var getScroller = function () {
      if (scrollerChecked) return scroller;
      scrollerChecked = true;
      var el = root ? root.parentElement : null;
      while (el && el !== doc.body && el !== doc.documentElement) {
        var ov = getComputedStyle(el).overflowY;
        if ((ov === 'auto' || ov === 'scroll') && el.scrollHeight > el.clientHeight + 1) { scroller = el; break; }
        el = el.parentElement;
      }
      return scroller;
    };
    var scrollPos = function () { var sc = getScroller(); return sc ? sc.scrollTop : (window.scrollY || doc.documentElement.scrollTop || 0); };
    var update = function () {
      ticking = false;
      var sc = getScroller();
      var vh = sc ? sc.clientHeight : (window.innerHeight || 900);
      var offset = sc ? sc.getBoundingClientRect().top : 0;
      var pins = doc.querySelectorAll('[data-pin]');
      for (var k = 0; k < pins.length; k++) {
        var sec = pins[k];
        var r = sec.getBoundingClientRect();
        var total = Math.max(1, r.height - vh);
        var p = Math.min(1, Math.max(0, (offset - r.top) / total));
        sec.style.setProperty('--p', p.toFixed(4));
        var steps = parseInt(sec.getAttribute('data-steps') || '0', 10);
        if (steps > 0) {
          var idx = Math.min(steps - 1, Math.floor(p * steps));
          if (sec.getAttribute('data-active') !== String(idx)) {
            sec.setAttribute('data-active', String(idx));
            var tabsIn = sec.querySelectorAll('[data-tour-tab]');
            for (var q = 0; q < tabsIn.length; q++) tabsIn[q].setAttribute('aria-current', tabsIn[q].getAttribute('data-tour-tab') === String(idx) ? 'true' : 'false');
          }
        }
      }
    };
    var onScroll = function () {
      if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    doc.addEventListener('scroll', onScroll, { passive: true, capture: true });
    window.addEventListener('resize', onScroll);

    /* When a resize flips the page between pinned and flowing layouts (the 600px / 800px height thresholds),
       document height changes a lot; keep whichever section was on screen at the same relative position. */
    var resizeAnchor = null;
    var resizeTimer = null;
    var anchorNow = function () {
      var sc = getScroller();
      var vh = sc ? sc.clientHeight : (window.innerHeight || 900);
      var offset = sc ? sc.getBoundingClientRect().top : 0;
      var secs = doc.querySelectorAll('main > section');
      for (var a = 0; a < secs.length; a++) {
        var r = secs[a].getBoundingClientRect();
        if (r.bottom - offset > vh * 0.4) return { el: secs[a], ratio: (offset - r.top) / Math.max(1, r.height) };
      }
      return null;
    };
    window.addEventListener('resize', function () {
      if (!resizeAnchor) resizeAnchor = anchorNow();
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        var anchor = resizeAnchor; resizeAnchor = null;
        if (!anchor || !anchor.el) return;
        var sc = getScroller();
        var offset = sc ? sc.getBoundingClientRect().top : 0;
        var r = anchor.el.getBoundingClientRect();
        var target = scrollPos() + (r.top - offset) + anchor.ratio * r.height;
        if (Math.abs(target - scrollPos()) < 8) return;
        if (sc) sc.scrollTo({ top: target, behavior: 'instant' }); else window.scrollTo({ top: target, behavior: 'instant' });
        onScroll();
      }, 180);
    });


    var reveals = doc.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) entries[i].target.classList.add('in');
        }
      }, { threshold: 0.12 });
      for (var j = 0; j < reveals.length; j++) io.observe(reveals[j]);
      this._io = io;
    } else {
      for (var m = 0; m < reveals.length; m++) reveals[m].classList.add('in');
    }

    var tabs = doc.querySelectorAll('[data-tour-tab]');
    for (var t = 0; t < tabs.length; t++) {
      tabs[t].addEventListener('click', function (ev) {
        var tab = ev.currentTarget;
        var sec = tab.closest('[data-pin]');
        if (!sec) return;
        var steps = parseInt(sec.getAttribute('data-steps') || '1', 10);
        var i = parseInt(tab.getAttribute('data-tour-tab'), 10);
        var scv = getScroller();
        var vh = scv ? scv.clientHeight : (window.innerHeight || 900);
        var total = sec.offsetHeight - vh;
        var sc = getScroller();
        var y = scrollPos();
        var top = sec.getBoundingClientRect().top - (sc ? sc.getBoundingClientRect().top : 0) + y + total * ((i + 0.5) / steps);
        if (sc) sc.scrollTo({ top: top, behavior: 'smooth' }); else window.scrollTo({ top: top, behavior: 'smooth' });
      });
    }

    update();
    this._cleanup = function () {
      window.removeEventListener('scroll', onScroll);
      doc.removeEventListener('scroll', onScroll, true);
      window.removeEventListener('resize', onScroll);
    };
  }
  componentWillUnmount() {
    if (this._cleanup) this._cleanup();
    if (this._io) this._io.disconnect();
  }
}
new HomeStory().componentDidMount();
</script>
