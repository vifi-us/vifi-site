---
// The homepage story, ported from the design canvas (design/vifi-site-story/Main.dc.html).
// Pinned, scroll-driven sections on desktop and tablet; a flowing layout on phones and short
// viewports; a no-script fallback via the .site:not(.js) rules in src/styles/design.css.
import { getCollection } from "astro:content";
import { siteConfig } from "../../data/site";
import { comparisonCategories, comparisonFeatures } from "../../data/comparisons";
import { secondaryFeatures } from "../../data/featurePage";
import { pricingTiers } from "../../data/pricing";
import HomeServicesPath from "../blocks/HomeServicesPath.astro";
import TrialPath from "../blocks/TrialPath.astro";

// "Stacked up": one column per comparison category; this one gets the highlighted treatment.
const VIFI = "ViFi";

// "More to explore": the three newest published posts, each keyed to one of the design's three doodles.
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const postBlobs = [
  "M22 30 Q18 8 44 10 L356 6 Q386 4 382 30 L390 386 Q392 412 364 410 L40 416 Q12 418 16 390 Z",
  "M18 34 Q14 10 42 12 L358 4 Q388 2 386 32 L392 384 Q394 414 366 412 L38 418 Q8 420 12 392 Z",
  "M24 28 Q20 6 48 8 L352 10 Q384 8 380 34 L388 388 Q390 414 362 412 L44 414 Q14 416 18 388 Z",
];
const postArt = [
  "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z M16 4l5 5 M21 4l-5 5",
  "M3 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0Z M13 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0Z M7 16h10 M2 2l20 20",
  "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5 M12 16.5v.01",
];
