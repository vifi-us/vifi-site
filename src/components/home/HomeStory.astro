    <!-- HERO -->
    <section class="hero shell" id="top">
      <!-- Above-the-fold copy and signup must paint without waiting for the
           scroll observer or its 640ms opacity transition. -->
      <div class="hero-copy">
        <p class="eyebrow"><i></i> The phone assistant that reports back</p>
        <h1>The AI receptionist that<br>briefs you after every&nbsp;call.</h1>
        <p class="lede">ViFi answers when your small business cannot, captures what each caller needs, and sends the summary, transcript, and recording your team needs to follow up with context.</p>
        <div class="hero-actions">
          <a class="btn" href={siteConfig.registerUrl} data-cta="home-hero" data-cta-version="home-positioning-2026-08-v1">Start free — no card
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7 M8 7h9v9"></path></svg>
          </a>
          <a class="text-link" href="#tour">Watch a call unfold
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14 M6 13l6 6 6-6"></path></svg>
          </a>
        </div>
        <p class="fine"><span>7-day free trial</span><i></i><span>Keep your current number</span><i></i><span>Cancel anytime</span></p>
      </div>

