    <!-- PRODUCT TOUR (pinned, 5 steps) -->
    <section class="tour" id="tour" data-pin data-steps="5" data-active="0">
      <div class="tour-sticky">
        <h2 class="tour-flow-head shell">One call, start to finish</h2>
        <div class="shell tour-head">
          <div class="tour-title" data-step="0"><h2>ViFi picks up</h2><p>A professional greeting in your business's voice, every time, no phone tree.</p></div>
          <div class="tour-title" data-step="1"><h2>The conversation, understood</h2><p>A live transcript, the caller's intent, and the details you'd ask for yourself.</p></div>
          <div class="tour-title" data-step="2"><h2>Your next move, already written</h2><p>A summary, action items, and an email in your inbox the moment the call ends.</p></div>
          <div class="tour-title" data-step="3"><h2>Next time, she isn't a stranger</h2><p>Caller memory builds a profile from every conversation, so regulars feel like regulars.</p></div>
          <div class="tour-title" data-step="4"><h2>Every question makes the next call better</h2><p>Unanswered topics show you what callers asked, so you know exactly what to teach it next.</p></div>
        </div>

        <div class="shell tour-tabs" aria-label="Call journey">
