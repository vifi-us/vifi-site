          <button class="tab" type="button" aria-current="false" aria-label="Brief" data-tour-tab="2"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></i><small>Brief</small></button>
