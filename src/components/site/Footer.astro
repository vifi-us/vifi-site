---
import { footerNavigation } from "../../data/navigation";
import { siteConfig } from "../../data/site";
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="wordmark" href="/" aria-label="ViFi home">Vi<em>Fi</em><b aria-hidden="true"></b></a>
      <p>{siteConfig.tagline} Built for small businesses that run on the phone.</p>
      <SocialLinks />
    </div>

    {
      footerNavigation.map((section) => (
        <div class="footer-col">
          <b>{section.title}</b>
          {section.links.map((link) => (
            <a href={link.href} data-cta={link.cta}>
              {link.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <div class="shell footer-bottom">
    <span>© {currentYear} ViFi. All rights reserved.</span>
    <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
  </div>
</footer>
