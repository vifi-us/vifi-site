---
import { navigation } from "../../data/navigation";
import { siteConfig } from "../../data/site";
---

<header class="nav" data-nav>
  <div class="shell nav-inner">
    <a class="wordmark" href="/" aria-label="ViFi home">Vi<em>Fi</em><b aria-hidden="true"></b></a>

    <nav class="nav-links" aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav-actions">
      <a class="login" href={siteConfig.loginUrl} data-cta="header-login">Log in</a>
      <a
        class="btn outline small"
        href={siteConfig.registerUrl}
        data-cta="header"
        data-cta-version="header-2026-08-v1"
      >
        Start free
      </a>
      <button
        class="menu-btn"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
      >
        <svg class="bars" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16 M4 16h16"></path></svg>
        <svg class="x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12 M18 6 6 18"></path></svg>
      </button>
    </div>
  </div>

  <nav class="nav-menu" id="site-menu" aria-label="Site navigation" data-nav-menu>
    <div class="shell">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={siteConfig.loginUrl} data-cta="header-mobile-login">Log in</a>
      <a
        class="btn"
        href={siteConfig.registerUrl}
        data-cta="header-mobile"
        data-cta-version="header-2026-08-v1"
      >
        Start free
      </a>
    </div>
  </nav>
</header>

<script>
  // Sticky bar state and the menu below 1080px. No hover-only behaviour;
  // Escape, outside taps, scrolling and link clicks all close the panel.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-menu] a");

  if (nav && menuBtn) {
    let openedAt: number | null = null;

    const setOpen = (open: boolean) => {
      nav.classList.toggle("menu-open", open);
      openedAt = open ? window.scrollY : null;
      menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      menuBtn.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    };

    menuBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!nav.classList.contains("menu-open"));
    });

    const outside = (event: Event) => {
      if (nav.classList.contains("menu-open") && !nav.contains(event.target as Node)) setOpen(false);
    };
    document.addEventListener("click", outside);
    document.addEventListener("pointerdown", outside);

    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("menu-open")) {
        setOpen(false);
        menuBtn.focus();
      }
    });

    menuLinks.forEach((link) => link.addEventListener("click", () => setOpen(false)));

    window.addEventListener("resize", () => {
      if (window.innerWidth > 1080 && nav.classList.contains("menu-open")) setOpen(false);
    });

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        ticking = false;
        const y = window.scrollY;
        nav.classList.toggle("is-scrolled", y > 24);
        if (openedAt !== null && Math.abs(y - openedAt) > 24) setOpen(false);
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
