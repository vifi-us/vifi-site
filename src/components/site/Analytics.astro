---
/**
 * PostHog product analytics + session replay and Google Analytics 4.
 *
 * - Loads the official snippet (array.js) from the ViFi-managed reverse
 *   proxy t.vifi.us — a first-party asset host, so ad-blockers that block
 *   *.posthog.com don't silently drop real-user data.
 * - Uses the SAME PostHog project as app.vifi.us. posthog-js writes its
 *   identity cookie (ph_<token>_posthog) against `.vifi.us`, so the
 *   anonymous distinct_id, session, and first-touch attribution (landing
 *   URL incl. utm params, referrer) carry over when a visitor clicks
 *   through to app.vifi.us and merge into their person on login.
 * - The phc_ token is a publishable client key, not a secret — it is
 *   already served in the page HTML of app.vifi.us. Hardcoding keeps the
 *   GitHub Pages build free of env plumbing.
 * - Unlike the app (which masks all text), marketing pages are public
 *   content with no user PII, so replays record page text; typed input is
 *   always masked.
 * - A hostname guard keeps `npm run dev`, `npm run preview`, and the
 *   test-site.vifi.us tunnel from polluting production analytics.
 * - Visitors sending the Global Privacy Control signal are not tracked at
 *   all (the privacy policy states this — keep the two in sync).
 * - GA4 uses the existing ViFi Website stream (G-EKB6V11FV8). Google Signals
 *   and ad-personalization signals are disabled; GA4 is used for aggregate
 *   acquisition and site-performance reporting, not advertising.
 */
---

<script is:inline>
  var attributionStorageKey = "vifi_marketing_touch_v1";
  // Clear only our own short-lived attribution record when privacy is enabled.
  // Do not inspect the record, start analytics, or affect unrelated storage.
  if (/^(www\.)?vifi\.us$/.test(location.hostname) && navigator.globalPrivacyControl) {
    try { window.sessionStorage.removeItem(attributionStorageKey); } catch (_) {}
  }
  if (
    /^(www\.)?vifi\.us$/.test(location.hostname) &&
    !navigator.globalPrivacyControl
  ) {
    /* Google Analytics 4 — production marketing site only. */
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    window.gtag("js", new Date());
    window.gtag("config", "G-EKB6V11FV8", {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    var gaScript = document.createElement("script");
    gaScript.async = true;
    gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-EKB6V11FV8";
    document.head.appendChild(gaScript);

    /* Official PostHog snippet — keep in sync with posthog.com/docs/libraries/js */
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

    posthog.init("phc_qHsZqUDmmu7PnUTzqBGBneGFS3sW5zdgNuqiQvcNVN3q", {
      api_host: "https://t.vifi.us",
      ui_host: "https://us.posthog.com",
      // Match the app's init (vifi-platform web/instrumentation-client.ts)
      // so both SDK instances sharing the .vifi.us cookie behave the same.
      defaults: "2026-01-30",
      // Person profiles materialize only when the user identifies (logs in
      // on app.vifi.us); anonymous marketing history merges retroactively.
      person_profiles: "identified_only",
      // TRUE is the posthog-js default on this hostname, but journey
      // stitching with app.vifi.us depends on it — pin it so an SDK
      // default change can't silently break attribution.
      cross_subdomain_cookie: true,
      capture_performance: { web_vitals: true },
      enable_heatmaps: true,
      // Match the app's hard-offs.
      capture_exceptions: false,
      enable_recording_console_log: false,
      // Public marketing content: record page text, never typed input.
      session_recording: { maskAllInputs: true },
      // PostHog Conversations (the app's support chat bubble) is enabled on
      // the shared project. The marketing site's bottom-right corner belongs
      // to the ViFi voice widget (VoiceWidget.astro); support lives in the app.
      disable_conversations: true,
    });

    // Preserve the campaign touch across the vifi.us -> app.vifi.us origin
    // boundary. posthog-js session properties are origin-scoped, so the
    // shared identity cookie alone does not retain latest-touch UTMs.
    // Retain one sanitized touch across internal pages in this tab for at most
    // 30 minutes. Internal navigation never extends its lifetime. Do not store
    // raw URLs, referrers, form values, or person identifiers.
    var campaignKeys = [
      "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "ref",
    ];
    var clickIdKeys = [
      "gclid", "gbraid", "wbraid", "dclid", "fbclid", "msclkid", "twclid",
      "li_fat_id", "ttclid", "rdt_cid", "igshid", "mc_cid",
    ];
    var phoneLike = function (value) {
      return /^[0-9+(). _:/-]+$/.test(value) && value.replace(/\D/g, "").length >= 10;
    };
    var safeCampaignValue = function (value) {
      return typeof value === "string" && value.length <= 128 &&
        /^[A-Za-z0-9][A-Za-z0-9 ._~+:/-]*$/.test(value) &&
        !value.includes("@") &&
        !/\d{8,}/.test(value) &&
        !phoneLike(value);
    };
    var safeClickId = function (value) {
      return typeof value === "string" && value.length <= 256 &&
        /^[A-Za-z0-9][A-Za-z0-9._~-]*$/.test(value) &&
        !phoneLike(value);
    };
    var attributionKeys = campaignKeys.concat(clickIdKeys);
    var touchLifetime = 30 * 60 * 1000;
    var isSafeAttribution = function (key, value) {
      return campaignKeys.includes(key) ? safeCampaignValue(value) :
        clickIdKeys.includes(key) && safeClickId(value);
    };
    var clearStoredTouch = function () {
      try { window.sessionStorage.removeItem(attributionStorageKey); } catch (_) {}
    };
    var readStoredTouch = function () {
      try {
        var raw = window.sessionStorage.getItem(attributionStorageKey);
        if (!raw) return null;
        var touch = raw.length <= 8192 ? JSON.parse(raw) : null;
        if (!touch || touch.version !== 1 ||
          Object.keys(touch).sort().join(",") !== "observedAt,values,version" ||
          !Number.isFinite(touch.observedAt) || touch.observedAt < 0 ||
          touch.observedAt > Date.now() || Date.now() - touch.observedAt >= touchLifetime ||
          !touch.values || typeof touch.values !== "object" || Array.isArray(touch.values) ||
          !Object.keys(touch.values).length ||
          !Object.keys(touch.values).every(function (key) {
            return isSafeAttribution(key, touch.values[key]);
          })) {
          clearStoredTouch();
          return null;
        }
        return touch;
      } catch (_) {
        clearStoredTouch();
        return null;
      }
    };
    var currentTouch = function () {
      var params = new URL(location.href).searchParams;
      var values = {};
      var provided = false;
      attributionKeys.forEach(function (key) {
        var candidates = params.getAll(key);
        if (candidates.length) provided = true;
        if (candidates.length === 1 && isSafeAttribution(key, candidates[0])) {
          values[key] = candidates[0];
        }
      });
      return { provided: provided, values: values };
    };
    var initialTouch = currentTouch();
    var previousTouch = readStoredTouch();
    if (initialTouch.provided) {
      if (!Object.keys(initialTouch.values).length) {
        // Invalid campaign input must not resurrect an unrelated prior touch.
        clearStoredTouch();
      } else {
        var sameTouch = previousTouch &&
          Object.keys(initialTouch.values).length === Object.keys(previousTouch.values).length &&
          Object.keys(initialTouch.values).every(function (key) {
            return initialTouch.values[key] === previousTouch.values[key];
          });
        try {
          // A single replacement prevents hybrid campaigns. Reloading the same
          // tagged page does not restart the original 30-minute lifetime.
          window.sessionStorage.setItem(attributionStorageKey, JSON.stringify({
            version: 1,
            observedAt: sameTouch ? previousTouch.observedAt : Date.now(),
            values: initialTouch.values,
          }));
        } catch (_) {
          clearStoredTouch();
        }
      }
    }
    var decorateAppDestination = function (destination) {
      // An explicitly attributed destination is one whole touch. Never mix it
      // with either a current-URL or a stored source/campaign/click-ID bundle.
      if (attributionKeys.some(function (key) { return destination.searchParams.has(key); })) {
        return destination;
      }
      var current = currentTouch();
      var stored = current.provided ? null : readStoredTouch();
      var values = current.provided ? current.values : stored ? stored.values : {};
      Object.keys(values).forEach(function (key) {
        destination.searchParams.set(key, values[key]);
      });
      return destination;
    };

    // Curated conversion events for clicks into the app. Registration and
    // login stay separate so login activity cannot inflate signup intent.
    // Delegated, so one listener covers every current and
    // future CTA. sendBeacon lets the capture survive same-tab navigation
    // once the SDK has loaded; clicks during the brief array.js load window
    // only reach the snippet's in-memory stub and are lost with the page —
    // the funnel still catches those visitors via the /register pageview.
    var decoratedAppLinks = new WeakMap();
    var captureCtaClick = function (event) {
      if (event.type === "auxclick" && event.button !== 1) return;
      var target = event.target instanceof Element ? event.target : null;
      var anchor = target && target.closest('a[href]');
      if (!anchor) return;
      var rememberedLink = decoratedAppLinks.get(anchor);
      var linkHref = anchor.getAttribute("href");
      var originalHref = rememberedLink && linkHref === rememberedLink.decoratedHref
        ? rememberedLink.originalHref : linkHref;
      if (navigator.globalPrivacyControl) {
        clearStoredTouch();
        if (originalHref !== linkHref) anchor.href = originalHref;
        decoratedAppLinks.delete(anchor);
        return;
      }
      if (!window.posthog) return;
      var destination = new URL(originalHref, location.href);
      // Only authentication destinations contribute to the conversion funnel.
      // Prefix matching would count /register-help and unrelated app links.
      if (destination.origin !== "https://app.vifi.us") return;
      var path = destination.pathname.replace(/\/$/, "");
      if (path !== "/register" && path !== "/login") return;
      destination = decorateAppDestination(destination);
      // The browser resolves default navigation after the event dispatch, so
      // updating the anchor here also works for Ctrl/Cmd-click and auxclick.
      // Re-evaluate our own prior decoration on repeated/middle clicks so an
      // expired touch is not mistaken for an explicitly attributed link.
      anchor.href = destination.href;
      decoratedAppLinks.set(anchor, { originalHref: originalHref, decoratedHref: anchor.href });
      var eventName = path === "/register"
        ? "marketing_cta_clicked"
        : "marketing_login_clicked";
      var ctaText = (anchor.textContent || "")
        .trim()
        .replace(/\s+/g, " ")
        .slice(0, 100);
      var eventProperties = {
        placement: anchor.getAttribute("data-cta") || "unlabeled",
        cta_version: anchor.getAttribute("data-cta-version") || "unversioned",
        cta_intent: anchor.getAttribute("data-cta-intent") || "unspecified",
        cta_text: ctaText,
        destination: destination.href,
        page: location.pathname,
      };
      window.posthog.capture(
        eventName,
        eventProperties,
        { transport: "sendBeacon" },
      );
      window.gtag("event", eventName, eventProperties);
    };
    document.addEventListener("click", captureCtaClick);
    // Middle-click opens in a new tab via auxclick without firing click.
    document.addEventListener("auxclick", captureCtaClick);
  }
</script>
