---
const paths = [
  {
    eyebrow: "Commercial fit",
    title: "See the home-service call workflow",
    description:
      "Review how ViFi handles overflow and after-hours intake, captures service details, and briefs your team.",
    href: "#home-services-workflow",
    link: "See the workflow",
  },
  {
    eyebrow: "Compare options",
    title: "AI receptionist, answering service, or voicemail?",
    description:
      "Compare caller experience, escalation, post-call records, pricing models, and the work your team receives.",
    href: "/alternatives/",
    link: "Compare call-answering options",
  },
  {
    eyebrow: "Prove it first",
    title: "Run seven realistic test calls",
    description:
      "Use practical scenarios and a pass-or-fix scorecard before changing the number or call path customers already use.",
    href: "/blog/test-ai-receptionist-home-services/",
    link: "Use the test-call checklist",
  },
];
---

<section class="pb-16 sm:pb-24" aria-labelledby="home-services-next-step">
  <div class="mx-auto max-w-5xl px-6">
    <div class="max-w-3xl">
      <p class="eyebrow"><i></i> Start with your decision</p>
      <h2 id="home-services-next-step" class="mt-4">
        Find the answer you need without wading through a sales pitch
      </h2>
      <p class="lede mt-5">
        Choose the commercial workflow, a side-by-side comparison, or a
        practical trial plan. Each path answers a different question.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        paths.map((path) => (
          <article class="panel flex h-full flex-col p-6">
            <p class="font-mono text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
              {path.eyebrow}
            </p>
            <h3 class="mt-4 text-[20px] leading-snug text-text">{path.title}</h3>
            <p class="mt-3 flex-1 text-[15.5px] leading-relaxed text-muted">
              {path.description}
            </p>
            <a class="text-link mt-6" href={path.href}>
              {path.link}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14 M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
