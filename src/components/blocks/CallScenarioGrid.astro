---
// Example calls for a trade solution page: eyebrow, accent h2, lede, then one tint-bordered
// panel per scenario with the "Useful intake" line as a mono panel label.
interface Scenario {
  title: string;
  description: string;
  intake: string;
}

interface Props {
  industry: string;
  scenarios: Scenario[];
}

const { industry, scenarios } = Astro.props;
const sectionId = `call-scenarios-${industry.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<section class="pb-16 sm:pb-24" aria-labelledby={sectionId}>
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto mb-10 flex max-w-2xl flex-col items-center gap-4 text-center">
      <p class="eyebrow"><i></i> Calls worth testing</p>
      <h2 id={sectionId}>Build around real calls—not a scripted demo</h2>
      <p class="lede">
        Start with a narrow call type, define the information the team needs,
        and test the assistant's boundaries before routing more traffic.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        scenarios.map((scenario) => (
          <article class="panel flex flex-col p-6">
            <h3 class="text-xl text-text">{scenario.title}</h3>
            <p class="mt-3 text-[15px] leading-6 text-muted">{scenario.description}</p>
            <div class="mt-auto border-t border-border pt-5">
              <p class="panel-label">Useful intake:</p>
              <p class="text-[15px] leading-6 text-text">{scenario.intake}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
