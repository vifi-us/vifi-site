---
import {
  comparisonCategories,
  comparisonFeatures,
} from "../../data/comparisons";

const checkPath = "M4 12.5l5 5L20 6.5";
const crossPath = "M6 6l12 12 M18 6 6 18";
---

<section class="pb-16 sm:pb-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="swipe-cue mt-0" aria-hidden="true">Swipe to compare →</p>
    {/* "in" marks the check and cross strokes as already drawn: design.css only paints them inside a revealed ancestor, and this page has no reveal script. */}
    <div
      class="table-wrap in mt-0"
      tabindex="0"
      role="region"
      aria-label="Comparison table, scrolls sideways on small screens"
    >
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col"><span class="sr">Feature</span></th>
            {
              comparisonCategories.map((cat) =>
                cat.name === "ViFi" ? (
                  <th scope="col" class="vifi">
                    <span>Vi<em>Fi</em></span>
                  </th>
                ) : (
                  <th scope="col">{cat.name}</th>
                )
              )
            }
          </tr>
        </thead>
        <tbody>
          {
            comparisonFeatures.map((row) => (
              <tr>
                <td>{row.feature}</td>
                {comparisonCategories.map((cat) => {
                  const value = row.values[cat.name];
                  return (
                    <td class:list={[cat.name === "ViFi" && "vifi", typeof value === "string" && "txt"]}>
                      {value === true ? (
                        <svg class="chk" viewBox="0 0 24 24" role="img" aria-label="Yes"><path d={checkPath}></path></svg>
                      ) : value === false ? (
                        <svg class="nope" viewBox="0 0 24 24" role="img" aria-label="No"><path d={crossPath}></path></svg>
                      ) : (
                        value
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
