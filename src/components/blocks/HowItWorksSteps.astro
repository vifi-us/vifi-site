---
// Three steps for /how-it-works as an ordered list: a mono index badge on an
// accent square, a dashed hand-drawn connector, ink title, muted description.
// Titles are h2s so the heading order under the page h1 stays valid.
const steps = [
  {
    title: "Forward your calls to ViFi",
    description:
      "Set up call forwarding from your existing business number. You keep your number, and callers won't notice any change. The whole process takes about two minutes.",
  },
  {
    title: "ViFi handles the conversation",
    description:
      "When a call comes in, ViFi answers with a professional greeting. It listens, responds to questions, and captures everything the caller needs. No scripts, no phone trees, no hold music.",
  },
  {
    title: "You get the full recap",
    description:
      "The moment the call ends, ViFi sends you a briefing: a short summary, the word-for-word transcript, and a recording you can replay anytime. You know the situation before you pick up the phone.",
  },
];
---

<section class="pb-16 sm:pb-24">
  <div class="mx-auto max-w-3xl px-6">
    <ol class="space-y-10 sm:space-y-12">
      {
        steps.map((step, index) => (
          <li class="relative flex items-start gap-5 sm:gap-7">
            {index < steps.length - 1 && (
              <span
                class="absolute -bottom-10 left-[23px] top-[calc(3rem+10px)] w-0 border-l-2 border-dashed border-accent/40 sm:-bottom-12 sm:left-[27px] sm:top-[calc(3.5rem+10px)]"
                aria-hidden="true"
              />
            )}
            <span
              class="grid h-12 w-12 shrink-0 place-items-center rounded-[10px] bg-accent font-mono text-[15px] font-semibold text-white shadow-[4px_4px_0_var(--color-text)] sm:h-14 sm:w-14 sm:text-base"
              aria-hidden="true"
            >
              0{index + 1}
            </span>
            <div class="pt-1.5 sm:pt-2.5">
              <h2 class="mb-2 text-[22px] leading-[1.25] tracking-[-0.02em] text-text">
                {step.title}
              </h2>
              <p class="text-[17px] leading-7 text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
