---
interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  tags: string[];
  slug: string;
  /** Index in the grid; picks one of the hand-drawn outlines so neighbours do not repeat. */
  variant?: number;
}

const { title, description, publishedAt, tags, slug, variant = 0 } = Astro.props;

const formattedDate = publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = publishedAt.toISOString().slice(0, 10);
const href = `/blog/${slug}/`;

// Hand-drawn outlines from the homepage's "More to explore" cards (viewBox 0 0 400 420).
const blobs = [
  "M22 30 Q18 8 44 10 L356 6 Q386 4 382 30 L390 386 Q392 412 364 410 L40 416 Q12 418 16 390 Z",
  "M18 34 Q14 10 42 12 L358 4 Q388 2 386 32 L392 384 Q394 414 366 412 L38 418 Q8 420 12 392 Z",
  "M24 28 Q20 6 48 8 L352 10 Q384 8 380 34 L388 388 Q390 414 362 412 L44 414 Q14 416 18 388 Z",
];
const blob = blobs[Math.abs(variant) % blobs.length];

// Stroke doodles (24x24) keyed by tag. The first matching entry wins, so specific tags sit before generic ones.
const doodles = {
  phone:
    "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z M16 4l5 5 M21 4l-5 5",
  voicemail: "M3 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0Z M13 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0Z M7 16h10 M2 2l20 20",
  question:
    "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5 M12 16.5v.01",
  house: "M3 11 12 3l9 8 M5 9.5V21h14V9.5 M10 21v-7h4v7",
  megaphone: "M3 11l18-5v12L3 14v-3z M11.6 16.8a3 3 0 1 1-5.8-1.6",
  lightbulb:
    "M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5 M9 18h6 M10 22h4",
  brief: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8",
  clipboard:
    "M8 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M9 14l2 2 4-4",
  sparkle: "M12 3c1.3 5.8 3.2 7.7 9 9-5.8 1.3-7.7 3.2-9 9-1.3-5.8-3.2-7.7-9-9 5.8-1.3 7.7-3.2 9-9z",
} as const;
const doodleByTag: Array<[string, keyof typeof doodles]> = [
  ["tips", "voicemail"],
  ["home services", "house"],
  ["announcement", "megaphone"],
  ["education", "question"],
  ["buyer guide", "clipboard"],
  ["product", "brief"],
  ["thought-leadership", "brief"],
  ["opinion", "lightbulb"],
  ["business", "phone"],
  ["insights", "lightbulb"],
  ["ai receptionist", "phone"],
  ["ai", "sparkle"],
];
const lowerTags = tags.map((tag) => tag.toLowerCase());
const match = doodleByTag.find(([tag]) => lowerTags.includes(tag));
const doodle = doodles[match ? match[1] : "phone"];
---

<article class="post">
  <svg class="blob light" viewBox="0 0 400 420" preserveAspectRatio="none" aria-hidden="true"><path d={blob}></path></svg>
  <div class="art"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={doodle}></path></svg></div>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <time datetime={isoDate} class="font-mono text-[12.5px] tracking-[0.02em] text-muted-2">{formattedDate}</time>
    {
      tags.length > 0 && (
        <div class="chips mt-0">
          {tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  <h2 class="text-[20px] leading-[1.25] tracking-[-0.02em] text-text"><a href={href} class="text-text hover:text-accent">{title}</a></h2>
  <p>{description}</p>
  <a class="text-link" href={href} aria-label={`Read the post: ${title}`}>
    Read the post
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
  </a>
</article>
