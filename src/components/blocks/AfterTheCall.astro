---
// Post-call deliverables for /how-it-works: heading + subtitle, then four
// .panel cards with a tint icon square, ink h3 and muted description.
const deliverables = [
  {
    icon: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z",
    title: "Post-call briefing",
    description:
      "A short summary of the conversation: who called, what they need, and what requires follow-up. Scan it in 30 seconds.",
  },
  {
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8",
    title: "Full transcript",
    description:
      "The complete word-for-word record of the call. Search it, reference it, or share it with your team.",
  },
  {
    icon: "M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z M19 10v2a7 7 0 0 1-14 0v-2 M12 19v3",
    title: "Call recording",
    description:
      "Turn on recording and play back any call on demand. Hear the tone, urgency, and details that text alone can't capture.",
  },
  {
    icon: "M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0",
    title: "Instant notification",
    description:
      "Get an email the moment a call wraps up, even when you can't answer. You're always in the loop.",
  },
];
---

<section class="pb-16 sm:pb-24">
  <div class="mx-auto max-w-4xl px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center sm:mb-12">
      <h2 class="mb-3">What happens after the call</h2>
      <p class="sub">
        Other tools answer the phone. ViFi tells you what happened on the call.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
      {
        deliverables.map((item) => (
          <div class="panel p-6 sm:p-7">
            <div class="mb-4 grid h-11 w-11 place-items-center rounded-[10px] bg-tint text-accent">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
            </div>
            <h3 class="mb-2 text-text">{item.title}</h3>
            <p class="text-[15px] leading-6 text-muted">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
