---
import { pricingTiers } from "../../data/pricing";
import { siteConfig } from "../../data/site";

// On the two-column tablet grid the last tier sits centered on its own row.
const lastIndex = pricingTiers.length - 1;
---

<section class="pb-16 sm:pb-24">
  <div class="relative mx-auto max-w-5xl px-6">
    <svg class="sprinkle -top-10 right-2" style="--dd: -1.4s;" viewBox="0 0 34 34" aria-hidden="true"><path d="M17 3 c2 9 5 12 14 14 c-9 2 -12 5 -14 14 c-2 -9 -5 -12 -14 -14 c9 -2 12 -5 14 -14 Z"></path></svg>
    <svg class="sprinkle -bottom-6 left-0" style="--dd: -3s;" viewBox="0 0 34 34" aria-hidden="true"><path d="M4 26 q6 -20 13 -6 q7 14 13 -6"></path></svg>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        pricingTiers.map((tier, index) => (
          <article
            class:list={[
              "card relative flex flex-col p-6 sm:p-7",
              tier.highlighted && "bg-tint shadow-[8px_8px_0_var(--color-accent)]",
              index === lastIndex &&
                "md:col-span-2 md:mx-auto md:w-full md:max-w-[calc(50%-1rem)] lg:col-span-1 lg:max-w-none",
            ]}
          >
            {tier.badge && (
              <span class="pill absolute -top-4 left-1/2 -translate-x-1/2 border-accent bg-accent text-white">
                {tier.badge}
              </span>
            )}

            <h2 class="text-[22px] leading-tight tracking-[-0.02em] text-text">{tier.name}</h2>

            <p class="mt-5 flex items-baseline gap-1.5">
              <span class="text-[44px] font-semibold leading-none tracking-[-0.03em] text-accent">{tier.price}</span>
              <span class="font-mono text-sm text-muted-2">{tier.period}</span>
            </p>

            <p class="mt-3 text-[15px] leading-relaxed text-muted">{tier.description}</p>

            <ul class="mt-6 flex flex-1 flex-col gap-3">
              {tier.features.map((feature, featureIndex) => (
                <li
                  class:list={[
                    "flex items-start gap-3 text-[15px] leading-snug text-text",
                    featureIndex === 0 && "font-semibold",
                  ]}
                >
                  <span
                    class:list={[
                      "mt-px grid h-5 w-5 shrink-0 place-items-center rounded-md text-accent",
                      tier.highlighted ? "bg-surface" : "bg-tint",
                    ]}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"></path></svg>
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href={siteConfig.registerUrl}
              data-cta={`pricing-${tier.name.toLowerCase()}`}
              data-cta-version="pricing-2026-08-v1"
              class:list={["btn mt-8 w-full justify-center", !tier.highlighted && "outline"]}
            >
              {tier.cta}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7 M8 7h9v9"></path></svg>
            </a>
          </article>
        ))
      }
    </div>

    <p class="mx-auto mt-12 max-w-2xl text-center text-[13.5px] leading-relaxed text-muted-2">
      Every plan includes a 7-day free trial. No credit card required. Eligible
      SMS segments apply only to ViFi's consent-based, fixed customer-care
      program described in the
      <a class="font-semibold underline underline-offset-4" href="/legal/messaging-policy/">Messaging Policy</a>.
    </p>
  </div>
</section>
