---
// Feature grid driven by src/data/features.ts, laid out like the homepage extras grid:
// tint icon square, accent h3, muted paragraph, no cards. `filter` matches feature titles.
import { features } from "../../data/features";
import type { Feature } from "../../data/features";

interface Props {
  filter?: string[];
}

const { filter } = Astro.props;

const displayFeatures: Feature[] = filter
  ? features.filter((f) => filter.includes(f.title))
  : features;

// Three columns only when they fill evenly (the full list of six); four items sit 2x2.
const threeUp = displayFeatures.length % 3 === 0;
---

<section class="pb-16 sm:pb-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="text-center">Everything you need after the call</h2>

    <div
      class:list={[
        "mt-12 grid gap-10 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-12",
        threeUp && "lg:grid-cols-3",
      ]}
    >
      {
        displayFeatures.map((feature) => (
          <div class="flex max-w-md flex-col gap-3.5">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-tint text-accent">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={feature.icon} />
              </svg>
            </div>
            <h3>{feature.title}</h3>
            <p class="text-base leading-relaxed text-muted">{feature.description}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-12 text-center">
      <a class="text-link" href="/features">
        See everything ViFi does
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
      </a>
    </p>
  </div>
</section>
