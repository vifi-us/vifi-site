---
import { estimatePlans, formatCost } from "../../utils/pricing-estimate";
import { siteConfig } from "../../data/site";
const initial = estimatePlans(150, 0);
---

<section id="estimate" class="pb-16 sm:pb-24" aria-labelledby="estimate-title">
  <div class="mx-auto max-w-5xl px-6">
    <div class="panel bg-tint p-6 sm:p-9" data-pricing-estimator>
      <p class="eyebrow mb-4">Find the cost that fits your calls</p>
      <h2 id="estimate-title">Estimate your monthly bill</h2>
      <p class="mt-4 max-w-3xl text-muted">Compare the monthly fee plus extra usage across all three plans. A larger allowance does not always mean a lower bill.</p>
      <form class="my-7 hidden items-end gap-5 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]" data-estimate-form>
        <div class="min-w-0">
          <label for="estimate-minutes" class="mb-2 block font-semibold">AI minutes per month</label>
          <input id="estimate-minutes" name="minutes" type="number" min="0" max="1000000" step="1" value="150" required aria-describedby="estimate-help" class="w-full rounded-lg border border-accent bg-surface p-3 text-text" />
        </div>
        <div class="min-w-0">
          <label for="estimate-sms" class="mb-2 block font-semibold">Eligible SMS segments</label>
          <input id="estimate-sms" name="sms" type="number" min="0" max="1000000" step="1" value="0" required class="w-full rounded-lg border border-accent bg-surface p-3 text-text" />
        </div>
        <button class="btn" type="submit">Compare costs</button>
      </form>
      <p id="estimate-help" class="my-5 text-sm leading-relaxed text-muted">Round each call up to a whole minute before adding them. For example, 50 calls lasting 2 minutes 10 seconds each use 150 AI minutes. Browser and widget calls count too. Enter SMS segments, not messages; long texts can use multiple segments.</p>
      <noscript><p class="mb-5">Example below: 150 AI minutes and no SMS usage. Enable JavaScript to enter your own usage.</p></noscript>
      <p class="mb-5 font-semibold text-accent" role="status" aria-live="polite" aria-atomic="true" data-estimate-summary>For 150 AI minutes and 0 SMS segments, Starter has the lowest estimated cost: $56.50/month.</p>
      <div class="grid gap-4 md:grid-cols-3">
        {initial.map((plan) => (
          <div class="panel bg-surface p-5" data-estimate-plan={plan.name}>
            <h3 class="text-xl">{plan.name}</h3>
            <p class="mt-3 text-3xl font-semibold text-accent"><span data-total>{formatCost(plan.totalCents)}</span><span class="text-sm font-normal text-muted"> /mo</span></p>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between gap-3"><dt>Monthly fee</dt><dd>{formatCost(plan.baseCents)}</dd></div>
              <div class="flex justify-between gap-3"><dt>Extra AI minutes</dt><dd data-minutes>{formatCost(plan.minuteCents)}</dd></div>
              <div class="flex justify-between gap-3"><dt>Extra SMS segments</dt><dd data-sms>{formatCost(plan.smsCents)}</dd></div>
            </dl>
          </div>
        ))}
      </div>
      <p class="mt-5 text-sm leading-relaxed text-muted">Estimates in USD, before taxes, discounts, or any separate charges. They cover the displayed subscription and usage rates; confirm your terms at checkout. SMS eligibility follows our <a class="underline underline-offset-4" href="/legal/messaging-policy/">Messaging Policy</a>. Inputs stay in your browser.</p>
      <div class="mt-6 flex flex-wrap items-center gap-5">
        <a class="btn" href={siteConfig.registerUrl} data-cta="pricing-estimator" data-cta-version="pricing-clarity-2026-09-v1" data-cta-intent="commercial">Test your calls free</a>
        <a class="text-link" href="/blog/ai-receptionist-pricing-billing-units/">How to compare call costs</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { estimatePlans, formatCost } from "../../utils/pricing-estimate";
  const root = document.querySelector<HTMLElement>("[data-pricing-estimator]");
  const form = root?.querySelector<HTMLFormElement>("[data-estimate-form]");
  if (root && form) {
    form.classList.remove("hidden");
    form.classList.add("grid");
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      const minutes = Number(values.get("minutes"));
      const sms = Number(values.get("sms"));
      const plans = estimatePlans(minutes, sms);
      for (const plan of plans) {
        const card = root.querySelector(`[data-estimate-plan="${plan.name}"]`);
        for (const [selector, cost] of [["[data-total]", plan.totalCents], ["[data-minutes]", plan.minuteCents], ["[data-sms]", plan.smsCents]] as const) {
          const target = card?.querySelector(selector);
          if (target) target.textContent = formatCost(cost);
        }
      }
      const lowest = Math.min(...plans.map((plan) => plan.totalCents));
      const names = plans.filter((plan) => plan.totalCents === lowest).map((plan) => plan.name);
      const summary = root.querySelector("[data-estimate-summary]");
      if (summary) summary.textContent = `For ${minutes.toLocaleString("en-US")} AI minutes and ${sms.toLocaleString("en-US")} SMS segments, ${names.join(" and ")} ${names.length === 1 ? "has" : "share"} the lowest estimated cost: ${formatCost(lowest)}/month.`;
    });
  }
</script>
