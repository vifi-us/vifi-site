---
import { getCollection, render } from "astro:content";
import { pricingFAQs } from "../../data/pricing";

interface Props {
  category?: string;
  /** Render the list's own "Frequently asked questions" h2. Pass false when the page h1 already says it. */
  heading?: boolean;
}

const { category, heading = true } = Astro.props;

const allFaqs = await getCollection("faqs");
const filteredFaqs = category
  ? allFaqs.filter((faq) => faq.data.category === category)
  : allFaqs;
const sortedFaqs = filteredFaqs.sort((a, b) => a.data.order - b.data.order);

// Pre-render all FAQ content
const renderedFaqs = await Promise.all(
  sortedFaqs.map(async (faq) => {
    const { Content } = await render(faq);
    return { question: faq.data.question, Content };
  })
);

// The inline pricing FAQs join the pricing category, minus any question the collection already answers.
const normalize = (question: string) => question.trim().toLowerCase();
const collectionQuestions = new Set(sortedFaqs.map((faq) => normalize(faq.data.question)));
const extraFaqs =
  category === "pricing"
    ? pricingFAQs.filter((faq) => !collectionQuestions.has(normalize(faq.question)))
    : [];

// Questions sit one heading level below the list's own heading.
const QuestionTag = heading ? "h3" : "h2";

const summaryClass =
  "cursor-pointer select-none list-none rounded-[8px] p-5 [&::-webkit-details-marker]:hidden focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-accent";
const questionClass = "flex items-center justify-between gap-4 text-[17px] leading-snug tracking-[-0.01em] text-text";
const chevronClass =
  "grid h-8 w-8 shrink-0 place-items-center rounded-full bg-tint text-accent transition-transform duration-200 group-open:rotate-180";
const answerClass =
  "px-5 pb-5 text-[15px] leading-relaxed text-muted [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-4 [&_p+p]:mt-3";
---

<section class="pb-16 sm:pb-24">
  <div class="mx-auto max-w-3xl px-6">
    {heading && <h2 class="mb-10 text-center">Frequently asked questions</h2>}

    <div class="flex flex-col gap-3">
      {
        renderedFaqs.map(({ question, Content }) => (
          <details class="group panel open:border-accent">
            <summary class={summaryClass}>
              <QuestionTag class={questionClass}>
                <span>{question}</span>
                <span class={chevronClass} aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 9.5c2.3 1.9 4.4 4 6.5 6.2 2.1-2.2 4.2-4.3 6.5-6.2"></path></svg>
                </span>
              </QuestionTag>
            </summary>
            <div class={answerClass}>
              <Content />
            </div>
          </details>
        ))
      }

      {
        extraFaqs.map((faq) => (
          <details class="group panel open:border-accent">
            <summary class={summaryClass}>
              <QuestionTag class={questionClass}>
                <span>{faq.question}</span>
                <span class={chevronClass} aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 9.5c2.3 1.9 4.4 4 6.5 6.2 2.1-2.2 4.2-4.3 6.5-6.2"></path></svg>
                </span>
              </QuestionTag>
            </summary>
            <div class={answerClass}>
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
