---
// Cross-link card steering home-service trades to their solution pages and the buyer's guide.
// Shared by the home, features, how-it-works and pricing pages. `spacing` replaces the outer
// section padding when a page needs its own rhythm (the home page adds top space after a
// pinned frame and lets the next section's own padding close the gap).
interface Props {
  spacing?: string;
}
const { spacing = "pb-16 sm:pb-24" } = Astro.props;

const trades = [
  { href: "/solutions/hvac/", label: "HVAC" },
  { href: "/solutions/plumbing/", label: "Plumbing" },
  { href: "/solutions/electricians/", label: "Electrical" },
];
---

<section class={spacing} aria-labelledby="home-services-path">
  <div class="shell">
    <div class="card mx-auto grid max-w-4xl gap-8 p-7 sm:p-10 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-12">
      <div>
        <p class="eyebrow"><i></i> For home-service teams</p>
        <h2 id="home-services-path" class="mt-4 text-[28px] sm:text-[32px]">
          Answer calls while the crew is on the&nbsp;job
        </h2>
        <p class="mt-4 text-[17px] leading-7 text-muted">
          See how plumbers, HVAC teams, electricians, roofers, and contractors can use an AI receptionist for overflow and after-hours intake.
        </p>
      </div>
      <div class="flex flex-col items-start gap-5">
        <a class="text-link" href="/solutions/home-services/">
          ViFi for home services
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
        </a>
        <ul class="flex flex-wrap gap-2" aria-label="Trades">
          {trades.map((trade) => (
            <li>
              <a
                class="inline-flex min-h-9 items-center rounded-lg border-[1.5px] border-accent bg-surface px-3 text-[13px] font-semibold text-accent shadow-[3px_3px_0_var(--color-tint-2)] transition-colors hover:bg-tint"
                href={trade.href}
              >
                {trade.label}
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href="/blog/ai-receptionist-home-services-buyers-guide/">
          Read the buyer's guide
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>
