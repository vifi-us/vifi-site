---
import { siteConfig } from "../../data/site";

interface Props {
  heading: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  ctaId?: string;
  ctaVersion?: string;
  note?: string;
}

const {
  heading,
  description,
  buttonText = "Start Free Trial",
  buttonHref = siteConfig.registerUrl,
  ctaId = "cta-banner",
  ctaVersion = "site-cta-2026-08-v1",
  note = "7-day free trial · No credit card required · Cancel anytime",
} = Astro.props;
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <div
      class="rounded-2xl border border-border bg-surface p-8 sm:p-12"
    >
      <h2
        class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight mb-4"
      >
        {heading}
      </h2>
      {
        description && (
          <p class="mx-auto max-w-lg text-base text-muted leading-relaxed mb-8">
            {description}
          </p>
        )
      }
      <a
        href={buttonHref}
        data-cta={ctaId}
        data-cta-version={ctaVersion}
        class="inline-block rounded-full bg-accent px-8 py-3.5 text-base font-semibold text-on-accent shadow-[0_4px_32px_var(--color-accent-glow)] transition hover:opacity-90 hover:-translate-y-0.5 hover:shadow-[0_8px_40px_var(--color-accent-glow-strong)]"
      >
        {buttonText}
      </a>
      {note && <p class="mt-4 text-xs text-muted">{note}</p>}
    </div>
  </div>
</section>
