---
// Centered page-title hero for every non-home page. `badge` renders as the
// design's mono eyebrow; the h1 inherits the accent 56px/40px sizing from
// design.css (.site h1).
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
}

const { title, subtitle, badge } = Astro.props;
---

<section class="pt-16 pb-12 sm:pt-24 sm:pb-16 text-center">
  <div class="mx-auto max-w-3xl px-6">
    {
      badge && (
        <p class="eyebrow mb-5">
          <i></i> {badge}
        </p>
      )
    }
    <h1 class="mb-5">{title}</h1>
    {subtitle && <p class="sub mx-auto max-w-2xl">{subtitle}</p>}
  </div>
</section>
