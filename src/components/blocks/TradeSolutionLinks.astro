---
// Related-trade navigation for the home-service solution pages: eyebrow, h2, and one
// outlined button per sibling trade, inside a tint-bordered panel.
import { solutions } from "../../data/solutions";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const tradeSlugs = ["home-services", "hvac", "plumbing", "electricians"];
const related = solutions.filter(
  (solution) => tradeSlugs.includes(solution.slug) && solution.slug !== currentSlug,
);
---

<nav class="pb-16 sm:pb-24" aria-label="Related home-service solutions">
  <div class="mx-auto max-w-5xl px-6">
    <div class="panel p-7 sm:p-9">
      <p class="eyebrow"><i></i> Explore by trade</p>
      <h2 class="mt-4 text-2xl sm:text-3xl">
        Call-answering workflows for home-service teams
      </h2>
      <div class="mt-7 flex flex-wrap gap-x-5 gap-y-4">
        {
          related.map((solution) => (
            <a class="btn outline small" href={`/solutions/${solution.slug}/`}>
              {solution.slug === "home-services"
                ? "All home services"
                : solution.industry}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>
