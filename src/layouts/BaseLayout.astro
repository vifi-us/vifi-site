---
import "../styles/global.css";
import Analytics from "../components/site/Analytics.astro";
import { socialLinks } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = "/og-default.png",
  ogType = "website",
  structuredData,
} = Astro.props;

const siteUrl = new URL("/", Astro.site).href;
const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: "ViFi",
  alternateName: "ViFi AI Phone Assistant",
  url: siteUrl,
  email: "hello@vifi.us",
  description:
    "ViFi provides an AI phone assistant and post-call briefings for small businesses.",
  sameAs: socialLinks.map((link) => link.href),
};

const siteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: "ViFi",
  alternateName: "ViFi AI Phone Assistant",
  url: siteUrl,
  publisher: { "@id": `${siteUrl}#organization` },
  description:
    "An AI phone assistant and virtual receptionist for small businesses.",
};

const jsonLd = [
  ...(Astro.url.pathname === "/"
    ? [organizationStructuredData, siteStructuredData]
    : []),
  ...(Array.isArray(structuredData)
    ? structuredData
    : structuredData
      ? [structuredData]
      : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8fafc" />

    <!-- Self-hosted fonts (see src/styles/global.css); preload the two the first paint needs. -->
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="ViFi" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />

    {
      jsonLd.map((entry) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(entry).replace(/</g, "\\u003c")}
        />
      ))
    }

    <Analytics />
  </head>
  <body class="min-h-screen bg-bg text-text font-sans antialiased">
    <!-- .site scopes the design system; .js is set before first paint so the
         scroll-driven homepage does not flash its no-script layout. -->
    <div class="site">
      <script is:inline>
        document.currentScript.parentElement.classList.add("js");
      </script>
      <a class="skip" href="#main">Skip to content</a>
      <slot />
      <!-- Reveal-on-scroll for any [data-reveal] element on any page (the
           homepage story observes its own as well; adding .in twice is harmless). -->
      <script is:inline>
        (function () {
          var els = document.querySelectorAll("[data-reveal]");
          if (!els.length) return;
          if (!("IntersectionObserver" in window)) {
            els.forEach(function (el) { el.classList.add("in"); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) entry.target.classList.add("in");
            });
          }, { threshold: 0.12 });
          els.forEach(function (el) { io.observe(el); });
        })();
      </script>
    </div>
  </body>
</html>
