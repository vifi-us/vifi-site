---
import "../styles/global.css";
import Analytics from "../components/site/Analytics.astro";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = "/og-default.png",
  ogType = "website",
  structuredData,
} = Astro.props;

const siteUrl = new URL("/", Astro.site).href;
const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: "ViFi",
  alternateName: "ViFi AI Phone Assistant",
  url: siteUrl,
  email: "hello@vifi.us",
  description:
    "ViFi provides an AI phone assistant and post-call briefings for small businesses.",
};

const siteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: "ViFi",
  alternateName: "ViFi AI Phone Assistant",
  url: siteUrl,
  publisher: { "@id": `${siteUrl}#organization` },
  description:
    "An AI phone assistant and virtual receptionist for small businesses.",
};

const jsonLd = [
  ...(Astro.url.pathname === "/"
    ? [organizationStructuredData, siteStructuredData]
    : []),
  ...(Array.isArray(structuredData)
    ? structuredData
    : structuredData
      ? [structuredData]
      : []),
];
---

<!doctype html>
<html lang="en" data-theme="shoreline" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme init: runs before rendering to prevent flash of wrong theme.
         Mode policy: the vifi-mode cookie (shared on .vifi.us, written ONLY
         when someone uses the theme toggle here or on app.vifi.us) is the
         single record of an explicit choice. No cookie = follow the OS
         setting, which resolves to light when no preference is expressed. -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('vifi-theme');
        var c = document.cookie.match(/(?:^|; )vifi-mode=(light|dark)/);
        var r = document.documentElement;
        if (t === 'shoreline' || t === 'nightfall') r.setAttribute('data-theme', t);
        if (c) r.setAttribute('data-mode', c[1]);
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
          r.setAttribute('data-mode', 'dark');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="ViFi" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />

    {
      jsonLd.map((entry) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(entry).replace(/</g, "\\u003c")}
        />
      ))
    }

    <Analytics />
  </head>
  <body
    class="min-h-screen bg-bg text-text font-sans antialiased overflow-x-hidden"
  >
    <slot />
  </body>
</html>
