# Public OpenAI Ads Pixel ID from Ads Manager. Blank disables measurement.
# Use the same Pixel ID as app.vifi.us. Never put a Conversions API key here.
PUBLIC_OPENAI_ADS_PIXEL_ID=
# Browser activation is separate from regional permission and server delivery.
# Public-site matching is disclosed; first-party choices still work while off.
PUBLIC_OPENAI_ADS_BROWSER_ENABLED=false
# Public Tolt program key (data-tolt) for the affiliate tracking script.
# Blank disables the script; partner ?ref= memory still works without it.
PUBLIC_TOLT_PUBLIC_KEY=
